[Unit]
Description=Unic-Tunnel Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=unicpanel
Group=unicpanel
WorkingDirectory=/var/lib/unic-panel
ExecStart=/usr/local/bin/unic-panel
Restart=on-failure
RestartSec=5
EnvironmentFile=/etc/unic-panel.env

# NOTE: NoNewPrivileges is intentionally NOT set — the panel calls sudo to
# provision tunnel users, which requires setuid to escalate. The sudoers entry
# (/etc/sudoers.d/unicpanel) restricts that escalation to one specific script.
#
# Critically, several systemd hardening flags IMPLICITLY set NoNewPrivileges=yes
# in a way that cannot be overridden — Protect{KernelTunables,KernelModules,
# ControlGroups}, RestrictNamespaces, RestrictRealtime, LockPersonality, etc.
# Including any of them here would silently break sudo. So the hardening below
# is deliberately restricted to flags that do NOT imply NoNewPrivileges.

ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/unic-panel
PrivateTmp=yes

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
