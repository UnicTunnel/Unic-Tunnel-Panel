[Unit]
Description=Unic-Tunnel Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=unicpanel
Group=unicpanel
WorkingDirectory=/var/lib/unic-panel
ExecStart=/usr/local/bin/unic-panel
Restart=on-failure
RestartSec=5
EnvironmentFile=/etc/unic-panel.env

# Hardening notes (each rejected flag and why):
#
# - NoNewPrivileges=yes — breaks sudo entirely (sudo needs setuid). Many other
#   ProtectX/RestrictX flags IMPLY this and cannot be overridden, so they're out.
#
# - ProtectSystem=strict — makes /etc read-only for the cgroup, even for sudo'd
#   children. useradd then can't lock /etc/passwd. Out.
#
# - ProtectHome=yes — hides /home, so useradd -m can't create /home/<u>. Out.
#
# The defense-in-depth comes from (a) running as the low-privilege `unicpanel`
# user and (b) the scoped sudoers entry that restricts privilege escalation to
# one specific script. PrivateTmp is safe and worth keeping — /etc and /home
# are outside /tmp so useradd is unaffected.

PrivateTmp=yes

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
